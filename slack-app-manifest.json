{
  "display_information": {
    "name": "Western WA Outage Watch",
    "description": "Low-volume alerts for significant reported power outages",
    "background_color": "#1e3a5f"
  },
  "features": {
    "bot_user": {
      "display_name": "Outage Watch",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write"]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
